!.env.example
!.env.*.example
!.env.template
.envrc
secrets/
credentials/
*.pem
*.key
*.p12
*.pfx

# Test output and coverage (keep test source and public fixtures)
coverage/
.coverage
.coverage.*
htmlcov/
playwright-report/
